{{define "layout"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{template "title" .}}</title>
  <link rel="stylesheet" href="/static/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='26' font-size='26'>&#9737;</text></svg>">
</head>
<body>
  <header class="site-header">
    <a class="wordmark" href="/">
      <span class="wordmark-glyph" aria-hidden="true">&#9737;&#65038;</span>
      <span>Birth Chart Calculator</span>
    </a>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch between light and dark">
      <span aria-hidden="true" data-theme-icon>&#9789;&#65038;</span>
    </button>
  </header>

  <main>
    {{template "main" .}}
  </main>

  <footer class="site-footer">
    <p>
      Positions from the VSOP87D planetary theory and Meeus&rsquo;s lunar and Pluto
      series, with Placidus houses. Calculated on this machine; nothing is sent
      anywhere unless you use the online place search.
    </p>
    <p class="footer-fine">
      Place data &copy; GeoNames, <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">CC&nbsp;BY&nbsp;4.0</a>.
    </p>
  </footer>

  <script src="/static/app.js" defer></script>
</body>
</html>
{{end}}
